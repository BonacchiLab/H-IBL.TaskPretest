                <Param name="Begin Routine" val="raw_keys = keySide.keys&#10;pressed_key = raw_keys[-1] if isinstance(raw_keys, list) and len(raw_keys) &gt; 0 else (raw_keys or &quot;&quot;)&#10;&#10;if correct_ans == keySide.keys:&#10;    score += 1&#10;    text_feedback = f&quot;Correto!\n+1 point\nTotal: {score}&quot;&#10;    win.color = &quot;green&quot;&#10;    durationtext = 1&#10;&#10;else:&#10;    score += 0&#10;    text_feedback = f&quot;Errado!\n+0 points\nTotal: {score}&quot;&#10;    win.color = &quot;red&quot;&#10;    durationtext = 2&#10;" valType="extendedCode" updates="constant" plugin="None"/>
