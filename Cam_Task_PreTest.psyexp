            </RoutineSettingsComponent>
            <CodeComponent name="codeFcondTut" plugin="None">
                <Param name="name" val="codeFcondTut" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="scoreT = 0" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="raw_keysT = keySideTut.keys&#10;pressed_key = raw_keysT[-1] if isinstance(raw_keysT, list) and len(raw_keysT) &gt; 0 else (raw_keysT or &quot;&quot;)&#10;&#10;if correct_ans == keySideTut.keys:&#10;    scoreT += 1&#10;    text_feedbackT = f&quot;Correto!\n+1 point\nTotal: {scoreT}&quot;&#10;    win.color = &quot;green&quot;&#10;    durationtextT = 1&#10;&#10;else:&#10;    scoreT += 0&#10;    text_feedbackT = f&quot;Errado!\n+0 points\nTotal: {scoreT}&quot;&#10;    win.color = &quot;red&quot;&#10;    durationtextT = 2&#10;&#10;&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="scoreT = 0;&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="raw_keysT = keySideTut.keys;&#10;pressed_key = (((raw_keysT instanceof Array) &amp;&amp; (raw_keysT.length &gt; 0)) ? raw_keysT.slice((- 1))[0] : (raw_keysT || &quot;&quot;));&#10;if ((correct_ans === keySideTut.keys)) {&#10;    scoreT += 1;&#10;    text_feedbackT = `Correto!&#10;+1 point&#10;Total: ${scoreT}`&#10;;&#10;    psychoJS.window.color = &quot;green&quot;;&#10;    durationtextT = 1;&#10;} else {&#10;    scoreT += 0;&#10;    text_feedbackT = `Errado!&#10;+0 points&#10;Total: ${scoreT}`&#10;;&#10;    psychoJS.window.color = &quot;red&quot;;&#10;    durationtextT = 2;&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
