            <CodeComponent name="GlobalCam" plugin="None">
                <Param name="name" val="GlobalCam" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="import cv2, threading, csv, atexit&#10;from psychopy import core&#10;&#10;CAM_INDEX = 0                       # 0 = built-in, 1 = external USB C270&#10;REQ_W, REQ_H, REQ_FPS = 640, 480, 30&#10;# EXPOSURE = -7                       # try -5, -6, -7 (more negative = darker but higher fps)&#10;&#10;class CamRecorder:&#10;    def __init__(self, index, video_path, csv_path):&#10;        self.ok = False&#10;        self.n = 0              # real frames captured&#10;        self.written = 0        # frames written to the video file&#10;        self.fps = float(REQ_FPS)&#10;        self._stop = threading.Event()&#10;        self.cap = cv2.VideoCapture(index, cv2.CAP_DSHOW)&#10;        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, REQ_W)&#10;        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, REQ_H)&#10;        self.cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*&quot;MJPG&quot;))&#10;        self.cap.set(cv2.CAP_PROP_FPS, REQ_FPS)&#10;        self.cap.set(cv2.CAP_PROP_AUTO_EXPOSURE, 0.25)   # manual exposure mode&#10;        # self.cap.set(cv2.CAP_PROP_EXPOSURE, EXPOSURE)&#10;        if not (self.cap.isOpened() and self.cap.read()[0]):&#10;            print(&quot;Camera failed to open. Running without recording.&quot;)&#10;            return&#10;        w = int(self.cap.get(cv2.CAP_PROP_FRAME_WIDTH))&#10;        h = int(self.cap.get(cv2.CAP_PROP_FRAME_HEIGHT))&#10;        fc = int(self.cap.get(cv2.CAP_PROP_FOURCC))&#10;        fmt = &quot;&quot;.join(chr((fc &gt;&gt; 8 * i) &amp; 0xFF) for i in range(4))&#10;        self.writer = cv2.VideoWriter(&#10;            video_path, cv2.VideoWriter_fourcc(*&quot;MJPG&quot;), self.fps, (w, h))&#10;        self._csvfile = open(csv_path, &quot;w&quot;, newline=&quot;&quot;)&#10;        self._csv = csv.writer(self._csvfile)&#10;        self._csv.writerow([&quot;real_frame&quot;, &quot;video_frame&quot;, &quot;psychopy_time&quot;])&#10;        self.t_first = None&#10;        self.t_last = None&#10;        self.ok = True&#10;        print(f&quot;Camera OK: {w}x{h}, format {fmt}, file written at {self.fps} fps&quot;)&#10;        self.thread = threading.Thread(target=self._loop, daemon=True)&#10;        self.thread.start()&#10;&#10;    def _loop(self):&#10;        t0 = None&#10;        while not self._stop.is_set():&#10;            ok, frame = self.cap.read()&#10;            t = core.getTime()&#10;            if not ok:&#10;                continue&#10;            if t0 is None:&#10;                t0 = t&#10;                self.t_first = t&#10;            self.t_last = t&#10;            # number of frames the file should contain at this instant&#10;            target = int((t - t0) * self.fps) + 1&#10;            first_idx = self.written&#10;            while self.written &lt; target:&#10;                self.writer.write(frame)&#10;                self.written += 1&#10;            # real frame -&gt; index of the first video-file frame that represents it&#10;            self._csv.writerow([self.n, first_idx, t])&#10;            self.n += 1&#10;&#10;    def stop(self):&#10;        if not self.ok:&#10;            return&#10;        self.ok = False&#10;        self._stop.set()&#10;        self.thread.join(timeout=2)&#10;        self.writer.release()&#10;        self.cap.release()&#10;        self._csvfile.close()&#10;        if self.t_last and self.t_first and self.t_last &gt; self.t_first:&#10;            dur = self.t_last - self.t_first&#10;            print(f&quot;Actual camera fps: {self.n / dur:.1f} &quot;&#10;                  f&quot;({self.n} real frames, {self.written} in file, {dur:.1f} s)&quot;)&#10;&#10;try:&#10;    base = filename&#10;except NameError:&#10;    base = thisExp.dataFileName&#10;&#10;video_path = base + &quot;_cam.avi&quot;&#10;csv_path = base + &quot;_cam_timestamps.csv&quot;&#10;rec = CamRecorder(CAM_INDEX, video_path, csv_path)&#10;atexit.register(rec.stop)" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="thisExp.addData(&quot;cam_frame_at_stim&quot;, rec.n)&#10;thisExp.addData(&quot;cam_time_at_stim&quot;, core.getTime())" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="rec.stop()&#10;print(&quot;Saved Capture.&quot;)" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="// Error in Python code" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="psychoJS.experiment.addData(&quot;cam_frame_at_stim&quot;, rec.n);&#10;psychoJS.experiment.addData(&quot;cam_time_at_stim&quot;, core.getTime());&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="rec.stop();&#10;console.log(&quot;Saved Capture.&quot;);&#10;" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
