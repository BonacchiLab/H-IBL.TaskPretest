            <CodeComponent name="codeLevels" plugin="None">
                <Param name="name" val="codeLevels" valType="code" updates="None" plugin="None"/>
                <Param name="Code Type" val="Auto-&gt;JS" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="levels_config = [&#10;    {&quot;min_score&quot;: 0,   &quot;name&quot;: &quot;Recruta&quot;},  &#10;    {&quot;min_score&quot;: 50,  &quot;name&quot;: &quot;Iniciante&quot;},  &#10;    {&quot;min_score&quot;: 100, &quot;name&quot;: &quot;Explorador&quot;},  &#10;    {&quot;min_score&quot;: 150, &quot;name&quot;: &quot;Praticante&quot;},  &#10;    {&quot;min_score&quot;: 200, &quot;name&quot;: &quot;Especialista&quot;},  &#10;    {&quot;min_score&quot;: 250, &quot;name&quot;: &quot;Perito&quot;},  &#10;    {&quot;min_score&quot;: 300, &quot;name&quot;: &quot;Mestre&quot;},  &#10;    {&quot;min_score&quot;: 350, &quot;name&quot;: &quot;Guru&quot;},  &#10;    {&quot;min_score&quot;: 400, &quot;name&quot;: &quot;Lenda&quot;}, &#10;    {&quot;min_score&quot;: 450, &quot;name&quot;: &quot;Titã&quot;}, &#10;    {&quot;min_score&quot;: 500, &quot;name&quot;: &quot;Divino&quot;}   &#10;]&#10;&#10;current_level = levels_config[0]&#10;next_level = None&#10;&#10;for level in levels_config:&#10;    if score &gt;= level[&quot;min_score&quot;]:&#10;        current_level = level&#10;    else:&#10;        next_level = level&#10;        break&#10;&#10;level_name = current_level[&quot;name&quot;]&#10;level_color = current_level[&quot;color&quot;]  &#10;&#10;&#10;text_pause = f&quot;Pausa\nPossui neste momento {score} pontos\n&quot;&#10;&#10;if score &gt;= 500:&#10;    text_pause += f&quot;Nível {level_name}\nNível Máximo Atingido!&quot;&#10;else:&#10;    pontos_em_falta = next_level[&quot;min_score&quot;] - score&#10;    text_pause += f&quot;Nível {level_name}\nFaltam {pontos_em_falta} pontos para o próximo nível&quot;&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="levels_config = [{&quot;min_score&quot;: 0, &quot;name&quot;: &quot;Recruta&quot;}, {&quot;min_score&quot;: 50, &quot;name&quot;: &quot;Iniciante&quot;}, {&quot;min_score&quot;: 100, &quot;name&quot;: &quot;Explorador&quot;}, {&quot;min_score&quot;: 150, &quot;name&quot;: &quot;Praticante&quot;}, {&quot;min_score&quot;: 200, &quot;name&quot;: &quot;Especialista&quot;}, {&quot;min_score&quot;: 250, &quot;name&quot;: &quot;Perito&quot;}, {&quot;min_score&quot;: 300, &quot;name&quot;: &quot;Mestre&quot;}, {&quot;min_score&quot;: 350, &quot;name&quot;: &quot;Guru&quot;}, {&quot;min_score&quot;: 400, &quot;name&quot;: &quot;Lenda&quot;}, {&quot;min_score&quot;: 450, &quot;name&quot;: &quot;Tit\u00e3&quot;}, {&quot;min_score&quot;: 500, &quot;name&quot;: &quot;Divino&quot;}];&#10;current_level = levels_config[0];&#10;next_level = null;&#10;for (var level, _pj_c = 0, _pj_a = levels_config, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&#10;    level = _pj_a[_pj_c];&#10;    if ((score &gt;= level[&quot;min_score&quot;])) {&#10;        current_level = level;&#10;    } else {&#10;        next_level = level;&#10;        break;&#10;    }&#10;}&#10;level_name = current_level[&quot;name&quot;];&#10;level_color = current_level[&quot;color&quot;];&#10;text_pause = `Pausa&#10;Possui neste momento ${score} pontos`&#10;;&#10;if ((score &gt;= 500)) {&#10;    text_pause += `Nível ${level_name}&#10;Nível Máximo Atingido!`&#10;;&#10;} else {&#10;    pontos_em_falta = (next_level[&quot;min_score&quot;] - score);&#10;    text_pause += `Nível ${level_name}&#10;Faltam ${pontos_em_falta} pontos para o próximo nível`&#10;;&#10;}&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
