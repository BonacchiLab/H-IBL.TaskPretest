        <Param val="current_phase = np.random.uniform(0, (2 * np.pi));&amp;#10;gabor.phase = current_phase;&amp;#10;psychoJS.experiment.addData(&quot;gabor_phase&quot;, current_phase);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
