      <CodeComponent name="codeFconditions" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="score = 0" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="score = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((correct_ans === keySide.keys)) {&amp;#10;    score += 1;&amp;#10;    if ((score === 50)) {&amp;#10;        text_feeback = `Correto!&amp;#10;Nível Principiante&amp;#10;50 pontos até ao próximo nível`&amp;#10;;&amp;#10;        psychoJS.window.color = &quot;green&quot;;&amp;#10;        sound_feedback = 4000;&amp;#10;        volume = 1;&amp;#10;        duration = 0.5;&amp;#10;    } else {&amp;#10;        text_feedback = `Correto!&amp;#10;+1 point&amp;#10;Total: ${score}`&amp;#10;;&amp;#10;        psychoJS.window.color = &quot;green&quot;;&amp;#10;        sound_feedback = 4000;&amp;#10;        volume = 1;&amp;#10;        duration = 0.5;&amp;#10;    }&amp;#10;} else {&amp;#10;    score += 0;&amp;#10;    text_feedback = `Errado!&amp;#10;+0 points&amp;#10;Total: ${score}`&amp;#10;;&amp;#10;    psychoJS.window.color = &quot;red&quot;;&amp;#10;    sound_feedback = 1000;&amp;#10;    volume = 1;&amp;#10;    duration = 1;&amp;#10;}&amp;#10;psychoJS.window.flip();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if correct_ans == keySide.keys:&amp;#10;    score += 1&amp;#10;    if score == 50:&amp;#10;        text_feeback = f&quot;Correto!\nNível Principiante\n50 pontos até ao próximo nível&quot;&amp;#10;        win.color = &quot;green&quot;&amp;#10;        sound_feedback = 4000&amp;#10;        volume = 1&amp;#10;        duration = 0.5&amp;#10;    else:&amp;#10;        text_feedback = f&quot;Correto!\n+1 point\nTotal: {score}&quot;&amp;#10;        win.color = &quot;green&quot;&amp;#10;        sound_feedback = 4000&amp;#10;        volume = 1&amp;#10;        duration = 0.5&amp;#10;else:&amp;#10;    score += 0&amp;#10;    text_feedback = f&quot;Errado!\n+0 points\nTotal: {score}&quot;&amp;#10;    win.color = &quot;red&quot;&amp;#10;    sound_feedback = 1000&amp;#10;    volume = 1&amp;#10;    duration = 1&amp;#10;&amp;#10;    &amp;#10;win.flip()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.window.color = &quot;gray&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="win.color=&quot;gray&quot;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="codeFconditions" valType="code" updates="None" name="name"/>
      </CodeComponent>
